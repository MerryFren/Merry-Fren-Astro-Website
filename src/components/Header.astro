---
import { SITE_TITLE } from '../consts';

import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2>
			<a href="/" class="brand">
				<img src="/favicon.svg" alt="Merry Fren $FREN Logo" width="28" height="28" />
				{SITE_TITLE}
			</a>
		</h2>

		<div class="desktop-nav">
			<div class="internal-links">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
				<HeaderLink href="/blog">News</HeaderLink>
			</div>

			<div class="social-links">
				<!-- X -->
				<a
					href="https://x.com/MerryFren"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Merry Fren on X"
				>
					<span class="sr-only">Merry Fren on X</span>
					<svg
						viewBox="0 0 24 24"
						aria-hidden="true"
						width="24"
						height="24"
					>
						<path
							fill="currentColor"
							d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817-5.963 6.817H1.684l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"
						/>
					</svg>
				</a>
			</div>
		</div>

		<button
			class="menu-toggle"
			type="button"
			aria-label="Open navigation menu"
			aria-expanded="false"
			aria-controls="mobile-menu"
		>
			<span></span>
			<span></span>
			<span></span>
		</button>
	</nav>

	<div id="mobile-menu" class="mobile-menu">
		<div class="mobile-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>

		<div class="mobile-social-links">
			<a
				href="https://x.com/MerryFren"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Merry Fren on X"
			>
				<span class="sr-only">Merry Fren on X</span>
				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
					width="24"
					height="24"
				>
					<path
						fill="currentColor"
						d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817-5.963 6.817H1.684l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"
					/>
				</svg>
			</a>
		</div>
	</div>
</header>

<script>
	const menuToggle = document.querySelector('.menu-toggle');
	const mobileMenu = document.querySelector('#mobile-menu');

	if (menuToggle && mobileMenu) {
		menuToggle.addEventListener('click', () => {
			const isOpen = mobileMenu.classList.toggle('open');

			menuToggle.classList.toggle('open', isOpen);
			menuToggle.setAttribute('aria-expanded', String(isOpen));
			menuToggle.setAttribute(
				'aria-label',
				isOpen ? 'Close navigation menu' : 'Open navigation menu'
			);
		});

		const mobileLinks = mobileMenu.querySelectorAll('a');

		mobileLinks.forEach((link) => {
			link.addEventListener('click', () => {
				mobileMenu.classList.remove('open');
				menuToggle.classList.remove('open');
				menuToggle.setAttribute('aria-expanded', 'false');
				menuToggle.setAttribute('aria-label', 'Open navigation menu');
			});
		});
	}
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 1000;
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}

	.brand {
	display: inline-flex;
	align-items: center;
	gap: 0.6rem;
	}

	.brand img {
		width: 2em;
		height: 2em;
		border-radius: 0.4em;
	}

	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.desktop-nav {
		display: flex;
		align-items: center;
	}

	.internal-links {
		display: flex;
		align-items: center;
		padding-right: 1.25rem;
	}

	nav a {
		padding: 0.1em 0.5em;
		color: var(--black);
		border-bottom: 1px solid transparent;
		text-decoration: none;
	}

	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}

	.social-links {
		display: flex;
		align-items: center;
		margin-left: 0.5em;
	}

	.social-links a {
		display: flex;
		align-items: center;
		padding: 0.75em;
	}

	.social-links svg {
		display: block;
	}

	.menu-toggle {
		display: none;
		width: 32px;
		height: 32px;
		padding: 4px;
		margin: 0;
		background: transparent;
		border: 0;
		cursor: pointer;
	}

	.menu-toggle span {
		display: block;
		width: 24px;
		height: 2px;
		margin: 5px 0;
		background: rgb(var(--black));
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
	}

	.mobile-menu {
		display: none;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 720px) {
		.desktop-nav {
			display: none;
		}

		.brand img {
			display: none;
		}

		.menu-toggle {
			display: block;
		}

		.mobile-menu {
			display: none;
			padding: 0.5em 0 1em;
			border-top: 1px solid rgba(var(--gray), 15%);
		}

		.mobile-menu.open {
			display: block;
		}

		.mobile-links {
			display: flex;
			flex-direction: column;
		}

		.mobile-links a {
			display: block;
			padding: 0.9em 0.5em;
			color: var(--black);
			border-bottom: 1px solid rgba(var(--gray), 15%);
			text-decoration: none;
		}

		.mobile-links a.active {
			color: var(--accent);
			border-bottom-color: var(--accent);
		}

		.mobile-social-links {
			display: flex;
			padding: 0.75em 0.5em 0;
		}

		.mobile-social-links a {
			display: flex;
			align-items: center;
			color: var(--black);
			text-decoration: none;
		}

		.mobile-social-links a:hover {
			color: var(--accent);
		}

		.menu-toggle.open span:nth-child(1) {
			transform: translateY(7px) rotate(45deg);
		}

		.menu-toggle.open span:nth-child(2) {
			opacity: 0;
		}

		.menu-toggle.open span:nth-child(3) {
			transform: translateY(-7px) rotate(-45deg);
		}
	}
</style>